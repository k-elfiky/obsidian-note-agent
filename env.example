# Required
TAVILY_API_KEY=your-tavily-key
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/ObsidianVault

# LLM (pick a paid, stable model — avoid ":free" OpenRouter tiers in production)
LLM_MODEL=openrouter/anthropic/claude-3.5-haiku
OPENROUTER_API_KEY=your-openrouter-key
# GROQ_API_KEY=your-groq-key   # only if you use a groq/ model string

# Optional observability
AGENTOPS_API_KEY=your-agentops-key

# Tuning
MAX_REVISION_ATTEMPTS=2
RUN_TIMEOUT_SECONDS=600
LOG_LEVEL=INFO
